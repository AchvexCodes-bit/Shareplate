generator client { provider = "prisma-client-js" }

datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum Role { FOOD_PARTNER RECIPIENT_ORGANIZATION COURIER ADMIN }
enum AccountStatus { PENDING_VERIFICATION ACTIVE SUSPENDED DISABLED }
enum VerificationStatus { PENDING APPROVED REJECTED SUSPENDED }
enum OrganizationType { RESTAURANT BAKERY HOTEL SUPERMARKET CATERER EVENT_ORGANIZER NGO SHELTER COMMUNITY_KITCHEN OTHER }
enum ListingStatus { DRAFT PUBLISHED PARTIALLY_RESERVED FULLY_RESERVED PICKUP_SCHEDULED COLLECTED DELIVERED COMPLETED CANCELLED EXPIRED REJECTED DISPUTED }
enum StorageCondition { AMBIENT REFRIGERATED FROZEN HOT_HOLD OTHER }
enum QuantityUnit { PORTIONS KILOGRAMS BOXES TRAYS PACKS }
enum ReservationStatus { REQUESTED ACCEPTED PICKUP_SCHEDULED COLLECTED RECEIVED COMPLETED CANCELLED REJECTED }
enum PickupStatus { REQUESTED ASSIGNED RESCHEDULED COLLECTED DELIVERED CANCELLED ISSUE_REPORTED COMPLETED }
enum ComplaintStatus { OPEN IN_REVIEW RESOLVED DISMISSED }

model User { id String @id @default(cuid()) email String @unique passwordHash String name String phone String? emailVerifiedAt DateTime? accountStatus AccountStatus @default(PENDING_VERIFICATION) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt memberships OrganizationMember[] notifications Notification[] complaints Complaint[] auditLogs AuditLog[] }
model Organization { id String @id @default(cuid()) name String type OrganizationType description String? contactPerson String email String phone String? operatingHours String? maximumDailyCapacity Int? verificationStatus VerificationStatus @default(PENDING) accountStatus AccountStatus @default(PENDING_VERIFICATION) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt members OrganizationMember[] documents OrganizationDocument[] addresses Address[] listings FoodListing[] receivedReservations Reservation[] pickupsFrom PickupRequest[] pickupsTo PickupRequest[] }
model OrganizationMember { id String @id @default(cuid()) userId String organizationId String role Role user User @relation(fields:[userId],references:[id],onDelete:Cascade) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) @@unique([userId,organizationId]) @@index([organizationId]) }
model OrganizationDocument { id String @id @default(cuid()) organizationId String name String storageKey String status VerificationStatus @default(PENDING) uploadedAt DateTime @default(now()) reviewedAt DateTime? organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) }
model Address { id String @id @default(cuid()) organizationId String label String line1 String line2 String? city String state String postalCode String country String @default("India") latitude Float? longitude Float? isPrimary Boolean @default(false) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade) @@index([city,state]) }
model FoodCategory { id String @id @default(cuid()) name String @unique active Boolean @default(true) listings FoodListing[] }
model FoodListing { id String @id @default(cuid()) reference String @unique organizationId String categoryId String name String description String? quantityListed Int quantityReserved Int @default(0) quantityCollected Int @default(0) unit QuantityUnit servings Int preparationAt DateTime availableFrom DateTime availableUntil DateTime storageCondition StorageCondition ingredients String? allergens String? handlingInstructions String? condition String? photoUrl String? status ListingStatus @default(DRAFT) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict) category FoodCategory @relation(fields:[categoryId],references:[id],onDelete:Restrict) safety FoodSafetyRecord? reservations ReservationItem[] statusHistory ListingStatusHistory[] @@index([status,availableUntil]) @@index([organizationId]) @@index([categoryId]) }
model FoodSafetyRecord { id String @id @default(cuid()) listingId String @unique preparationTimestamp DateTime bestBeforeTimestamp DateTime? storageMethod String temperatureC Float? allergenInformation String? handlingInstructions String? condition String? listing FoodListing @relation(fields:[listingId],references:[id],onDelete:Cascade) }
model ListingStatusHistory { id String @id @default(cuid()) listingId String fromStatus ListingStatus? toStatus ListingStatus changedByUserId String? reason String? createdAt DateTime @default(now()) listing FoodListing @relation(fields:[listingId],references:[id],onDelete:Cascade) }
model Reservation { id String @id @default(cuid()) reference String @unique listingId String organizationId String quantity Int status ReservationStatus @default(REQUESTED) requestedById String collectionWindowStart DateTime collectionWindowEnd DateTime cancelledAt DateTime? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt listing FoodListing @relation(fields:[listingId],references:[id],onDelete:Restrict) organization Organization @relation(fields:[organizationId],references:[id],onDelete:Restrict) requestedBy User @relation(fields:[requestedById],references:[id],onDelete:Restrict) items ReservationItem[] pickup PickupRequest? @@index([organizationId,status]) @@index([listingId,status]) }
model ReservationItem { id String @id @default(cuid()) reservationId String listingId String quantity Int reservation Reservation @relation(fields:[reservationId],references:[id],onDelete:Cascade) listing FoodListing @relation(fields:[listingId],references:[id],onDelete:Restrict) @@unique([reservationId,listingId]) }
model Courier { id String @id @default(cuid()) userId String vehicleDetails String? active Boolean @default(true) user User @relation(fields:[userId],references:[id],onDelete:Cascade) assignments PickupAssignment[] }
model PickupRequest { id String @id @default(cuid()) reference String @unique reservationId String @unique sourceOrganizationId String destinationOrganizationId String status PickupStatus @default(REQUESTED) windowStart DateTime windowEnd DateTime issueNotes String? reservation Reservation @relation(fields:[reservationId],references:[id],onDelete:Restrict) sourceOrganization Organization @relation("sourcePickups",fields:[sourceOrganizationId],references:[id],onDelete:Restrict) destinationOrganization Organization @relation("destinationPickups",fields:[destinationOrganizationId],references:[id],onDelete:Restrict) assignments PickupAssignment[] statusHistory PickupStatusHistory[] delivery DeliveryConfirmation? }
model PickupAssignment { id String @id @default(cuid()) pickupId String courierId String assignedAt DateTime @default(now()) acceptedAt DateTime? pickup PickupRequest @relation(fields:[pickupId],references:[id],onDelete:Cascade) courier Courier @relation(fields:[courierId],references:[id],onDelete:Restrict) @@unique([pickupId,courierId]) }
model PickupStatusHistory { id String @id @default(cuid()) pickupId String fromStatus PickupStatus? toStatus PickupStatus changedByUserId String? note String? createdAt DateTime @default(now()) pickup PickupRequest @relation(fields:[pickupId],references:[id],onDelete:Cascade) }
model DeliveryConfirmation { id String @id @default(cuid()) pickupId String @unique collectedAt DateTime? deliveredAt DateTime? receivedByName String? notes String? pickup PickupRequest @relation(fields:[pickupId],references:[id],onDelete:Cascade) }
model Notification { id String @id @default(cuid()) userId String type String title String message String relatedEntityType String? relatedEntityId String? readAt DateTime? createdAt DateTime @default(now()) user User @relation(fields:[userId],references:[id],onDelete:Cascade) @@index([userId,readAt]) }
model Complaint { id String @id @default(cuid()) userId String organizationId String? reservationId String? pickupId String? title String description String status ComplaintStatus @default(OPEN) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User @relation(fields:[userId],references:[id],onDelete:Restrict) }
model ImpactRecord { id String @id @default(cuid()) organizationId String? reservationId String? portions Int weightKg Float? recordedAt DateTime @default(now()) }
model AuditLog { id String @id @default(cuid()) userId String? action String entityType String entityId String details Json? createdAt DateTime @default(now()) user User? @relation(fields:[userId],references:[id],onDelete:SetNull) @@index([entityType,entityId]) }
model SystemSetting { id String @id @default(cuid()) key String @unique value String updatedAt DateTime @updatedAt }
